{
  "additionalProperties": false,
  "properties": {
    "alertNumber": {
      "description": "The repository's Dependabot alert number.",
      "minimum": 1,
      "type": "integer"
    },
    "assignees": {
      "description": "Usernames replacing the entire assignee set; [] clears all, omission leaves it unchanged. Including copilot-swe-agent[bot] requests remediation, not just ownership bookkeeping.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "dismissed_comment": {
      "description": "Optional dismissal comment, up to 280 characters; not a standalone comment API.",
      "maxLength": 280,
      "type": "string"
    },
    "dismissed_reason": {
      "description": "Required when state is dismissed.",
      "enum": [
        "fix_started",
        "inaccurate",
        "no_bandwidth",
        "not_used",
        "tolerable_risk"
      ],
      "type": "string"
    },
    "owner": {
      "description": "Repository owner (username or organization).",
      "minLength": 1,
      "type": "string"
    },
    "repo": {
      "description": "Repository name.",
      "minLength": 1,
      "type": "string"
    },
    "state": {
      "description": "Reopen or dismiss the alert. Omission leaves state unchanged.",
      "enum": [
        "open",
        "dismissed"
      ],
      "type": "string"
    }
  },
  "required": [
    "owner",
    "repo",
    "alertNumber"
  ],
  "type": "object"
}
